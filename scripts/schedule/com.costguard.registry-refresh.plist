<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily column-registry refresh at 06:00 (macOS launchd). A template:
     scripts/schedule/install_launchd.sh fills in REPO and loads it. If the Mac
     is asleep at 06:00, launchd runs the job when it wakes. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.costguard.registry-refresh</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>REPO/scripts/schedule/refresh_registry.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardErrorPath</key><string>REPO/runs/registry_refresh.launchd.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
