# Copy to .env and fill in (never commit .env — see .gitignore). Loaded by
# cost_guard.config.load_dotenv(); a variable already set in the shell wins.

# Anthropic API key for the LLM parts (eval/run_column_kinds.py, --llm claude)
ANTHROPIC_API_KEY=

# GCP project holding the TheLook copies; BigQuery auth is gcloud's
# application-default login (gcloud auth application-default login)
GCP_PROJECT=

# Optional: key for the keyed SQL hash in the query log (runtime.py)
COST_GUARD_LOG_KEY=
